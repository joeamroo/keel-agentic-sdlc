        <mxCell id="gv1" value="every gate, retry, rollback and approval&#10;is recorded before it takes effect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F9A825;fontSize=10;fontColor=#8D6E00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="exec" target="gov"><mxGeometry relative="1" as="geometry" /></mxCell>
