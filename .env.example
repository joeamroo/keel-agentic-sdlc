# Copy to .env and fill in. .env is gitignored and must never be committed.

# Only required when KEEL_AGENT_MODE=live. Replay mode needs no key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# replay = play back committed transcripts (default, no key, no cost)
# live   = call the Anthropic API for real
KEEL_AGENT_MODE=replay

# Bearer token the orchestrator presents to stage agents.
KEEL_A2A_AUTH_TOKEN=keel-local-dev-token
